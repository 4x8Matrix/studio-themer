-process.cwd = zune.process.cwd()
+-- process.cwd can fail under Wine (error.Unexpected); fall back to "." so requiring the module never throws
+local cwdOk, cwd = pcall(zune.process.cwd)
+process.cwd = if cwdOk then cwd else "."
 
 function process.run(exec: string, args: { string }?, opts: { cwd: string?, env: { [string]: string }? }?)
