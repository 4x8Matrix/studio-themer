for spec, expectedList in EXPECTED do
	local themeMapper = mapper.makeMapper(spec)

	for index, sample in SAMPLES do
		local red, green, blue = themeMapper(sample[1], sample[2], sample[3])
		local expected = expectedList[index]

		assert(
			red == expected[1] and green == expected[2] and blue == expected[3],
			`{spec}({sample[1]}, {sample[2]}, {sample[3]}): expected {expected[1]}, {expected[2]}, {expected[3]}, got {red}, {green}, {blue}`
		)
	end
end

local role, hex = mapper.autoMap("#F04433", "mocha")
assert(role == "peach" and hex == "#C48F71", `autoMap #F04433: {role} {hex}`)

local known = mapper.knownSpecs()
assert(
	#known == 16 and known[1] == "latte" and known[4] == "mocha" and known[10] == "barbie" and known[16] == "ember",
	"knownSpecs order"
)

local mocha = mapper.makeMapper("mocha")
assert(mapper.resolveQtValue("mocha", "#40000000", mocha) == "#40000000", "keep leaves the value untouched")
assert(mapper.resolveQtValue("mocha", "#1ECCCCCC", mocha) == "#1ECDD6F4", "mix text 1.0 keeps alpha")
assert(mapper.resolveQtValue("mocha", "#13235D", mocha) == "#363F5B", "mix blue 0.22")
assert(mapper.resolveQtValue("mocha", "#202227", mocha) == "#1E1E2E", "explicit base")
assert(mapper.resolveQtValue("mocha", "#f04433", mocha) == "#F38BA8", "unmapped 6-hex falls through the total mapper")
assert(mapper.resolveQtValue("mocha", "#80F04433", mocha) == "#80F38BA8", "unmapped 8-hex keeps alpha and maps RGB")

local barbie = mapper.makeMapper("barbie")
assert(mapper.resolveQtValue("barbie", "#40000000", barbie) == "#4017080F", "transform maps RGB under the alpha")

local ok, message = pcall(mapper.makeMapper, "nope")
assert(not ok and string.find(tostring(message), "unknown theme spec 'nope'"), "unknown spec errors")

print("mapper: pass")
